DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/industrial_fire_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=industrial_fire_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
CORS_ORIGINS=http://localhost:5173

# NASA FIRMS near-real-time Area API
# Get a free MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
# Never commit the real key. Put it only in backend/.env (gitignored).
FIRMS_MAP_KEY=
FIRMS_BASE_URL=https://firms.modaps.eosdis.nasa.gov/api/area/csv
# VIIRS NOAA-20 NRT (aligns with historical JPSS-1 / N20 archive used in AIML)
FIRMS_PRODUCT=VIIRS_NOAA20_NRT
# west,south,east,north (India prototype default) or "world"
FIRMS_BBOX=68.0,6.0,98.0,37.5
# Area API allows 1..5 days per request
FIRMS_DAY_RANGE=2
FIRMS_TIMEOUT_SECONDS=60

# Phase 12 automatic NRT polling (default OFF so tests/dev do not hit NASA)
FIRMS_NRT_ENABLED=false
FIRMS_NRT_INTERVAL_MINUTES=15
